# Получите бесплатный ключ на https://console.groq.com/keys
GROQ_API_KEY=

# Модель распознавания: whisper-large-v3-turbo (быстрая и точная) или whisper-large-v3
GROQ_MODEL=whisper-large-v3-turbo

# Язык распознавания: ru (русский), en (английский), или оставьте пустым для автоопределения
LANGUAGE=ru

# Клавиша для зажатия (Push-to-Talk):
# Варианты: f8, f4, f7, caps_lock, scroll_lock, pause, insert
HOTKEY=f8

# Звуковой сигнал при старте и завершении записи (true / false)
ENABLE_SOUNDS=true

# Системная подсказка (помогает расставлять правильную пунктуацию и регистр)
SYSTEM_PROMPT=Привет! Это грамотная русская речь. Используй знаки препинания: запятые, точки, вопросительные и восклицательные знаки.
